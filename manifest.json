{
  "manifest_version": 3,
  "name": "Grab Design",
  "description": "Sélectionnez un élément de page et copiez son rendu HTML/CSS autonome.",
  "version": "0.1.0",
  "action": {
    "default_title": "Grab Design",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "offscreen"
  ]
}
